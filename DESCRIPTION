Package: ScreenR
Type: Package
Title: Hit Identification in Pooled shRNA and CRISPR-Cas9 Screens
Version: 1.15.16
Date: 2022-04-01 
Authors@R: c(person("Emanuel Michele", "Soda", role = c("aut", "cre"),
